pub fn TypedReference::not_equal(Self, Self) -> Bool
pub fn TypedReference::to_repr(Self) -> @debug.Repr

type UnknownStatus derive(Eq, Hash, @debug.Debug)
pub fn UnknownStatus::equal(Self, Self) -> Bool
pub fn UnknownStatus::hash(Self) -> Int32
pub fn UnknownStatus::hash_combine(Self, Hasher) -> Unit
pub fn UnknownStatus::not_equal(Self, Self) -> Bool
pub fn UnknownStatus::output(Self, &Logger) -> Unit
pub fn UnknownStatus::to_repr(Self) -> @debug.Repr
pub fn UnknownStatus::to_string(Self) -> String
pub impl Show for UnknownStatus

pub(all) struct UsageWindow {
  from : String?
  to : String?
} derive(Eq, @debug.Debug)
pub fn UsageWindow::equal(Self, Self) -> Bool
pub fn UsageWindow::not_equal(Self, Self) -> Bool
pub fn UsageWindow::to_repr(Self) -> @debug.Repr

type ValidationConfig
pub fn ValidationConfig::ValidationConfig(overrides? : ArrayView[(RuleName, Severity)], disabled? : ArrayView[RuleName]) -> Self
pub fn ValidationConfig::disabled(Self) -> ReadOnlyArray[RuleName]
pub fn ValidationConfig::overrides(Self) -> ReadOnlyArray[(RuleName, Severity)]

pub struct ValidationContext {
  knowledge : Knowledge
  graph : Graph
  now : Instant
  options : Options
  vocabulary : Vocabulary
  profiles : ReadOnlyArray[&Profile]
}

pub(all) enum Value {
  Scalar(String)
  Seq(ReadOnlyArray[Value])
  Mapping(Fields)
  Null
} derive(Eq, @debug.Debug)
pub fn Value::as_bool(Self) -> Bool?
pub fn Value::as_int(Self) -> Int32?
pub fn Value::as_mappings(Self) -> Array[Fields]
pub fn Value::as_text(Self) -> String?
pub fn Value::as_texts(Self) -> Array[String]
pub fn Value::equal(Self, Self) -> Bool
pub fn Value::not_equal(Self, Self) -> Bool
pub fn Value::to_repr(Self) -> @debug.Repr

type Vocabulary
pub fn Vocabulary::knows(Self, String) -> Bool
pub fn Vocabulary::knows_bundle_key(Self, String) -> Bool
pub fn Vocabulary::of_profiles(ArrayView[&Profile]) -> Self

// Type aliases

// Traits
pub(open) trait Clock {
  fn now(Self) -> Instant
}

pub(open) trait LinkResolver {
  fn exists(Self, StorePath) -> Bool
}

pub(open) trait Profile {
  fn name(Self) -> String
  fn vocabulary(Self) -> Array[KeyDefinition] raise ValueError = _
  fn bundle_keys(Self) -> Array[KeyDefinition] raise ValueError = _
  fn treats_as_asset(Self, BundlePath) -> Bool = _
  fn derive_metadata(Self, Document) -> Fields? = _
  fn registers(Self) -> Array[Register] raise ValueError = _
  fn reference_fields(Self) -> Array[ReferenceField] raise ValueError = _
  fn templates(Self) -> Array[Template] raise ValueError = _
  fn rule_sets(Self) -> Array[RuleSet] raise ValueError = _
  fn options(Self) -> Options? = _
  fn relations(Self, Bundle, Document) -> Array[Link] = _
  fn severities(Self) -> Array[(RuleName, Severity)] raise ValueError = _
}
