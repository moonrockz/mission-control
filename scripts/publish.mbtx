///|
/// Publish the public modules to mooncakes.io (CI only), in dependency order.
///
/// For each module of `publish_list` the script runs `moon update`, then `moon publish` in the module
/// directory, with retries for transient network failures. A version that mooncakes.io already holds counts as
/// published, so a second release run for the same tag succeeds. The script prints one line per module and
/// exits with 1 when a module failed.
///
/// Usage: `mise run release:publish`, or `moonx scripts/publish.mbtx`. It needs the credentials that
/// `scripts/credentials.mbtx` writes.
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/x@0.5.5/sys",
  "moonbitlang/core/env",
  "moonrockz/moonspec@0.11.0",
  "moonrockz/expect@0.6.1",
}

///|
/// The exit codes of the task scripts: 0 for success, 1 for a failure and 2
/// for a usage error. A script that succeeds ends `main` normally. Each script
/// keeps this copy, and `scripts/test-scripts.mbtx` checks that the copies are
/// equal.
enum ExitCode {
  Failure
  Usage
}

///|
/// Ends the script with this exit code.
fn ExitCode::exit(self : ExitCode) -> Unit {
  @sys.exit(
    match self {
      Failure => 1
      Usage => 2
    },
  )
}
// End of the exit codes.

///|
/// The packages to publish, with their module names, in dependency order. Add a line for each public
/// module. `scripts/release.mbtx` keeps the same list, and a scenario checks that the two are equal.
let publish_list : Array[(String, String)] = [
  ("pkgs/contracts", "moonrockz/mission-control-contracts"),
  ("pkgs/mdc", "moonrockz/mdc"),
  ("pkgs/ears", "moonrockz/ears"),
  ("pkgs/okf", "moonrockz/okf"),
  ("apps/cli", "moonrockz/mission-control-cli"),
  ("apps/openspec-ext", "moonrockz/openspec-ext"),
  ("apps/web", "moonrockz/mission-control-web"),
  ("apps/desktop", "moonrockz/mission-control-desktop"),
]

///|
/// What a `moon publish` run means.
enum Outcome {
  Published
  AlreadyPublished
  Transient
  Failed
} derive(Eq, Debug)

///|
fn classify(exit_code : Int32, output : String) -> Outcome {
  guard exit_code != 0 else { return Published }
  match classify_failure(output) {
    AlreadyPublished => AlreadyPublished
    Transient => Transient
    Refused | Conflict | Other => Failed
  }
}

///|
/// True when `word` occurs in `text` as whole words: the characters around it
/// are not letters or digits. So `401` matches `HTTP 401` but not `4013ab`,
/// and `eof` matches `unexpected EOF` but not `thereof`. `scripts/publish.mbtx`
/// and `scripts/release.mbtx` keep the same copy of this function and of the
/// failure classes below, and a scenario of `features/publish.feature` checks
/// that the copies are equal.
fn has_word(text : String, word : String) -> Bool {
  let is_word_char = (c : UInt16) => (c >= 48 && c <= 57) ||
    (c >= 65 && c <= 90) ||
    (c >= 97 && c <= 122)
  let n = word.length()
  let mut from = 0
  while from + n <= text.length() {
    match text[from:].find(word) {
      None => return false
      Some(i) => {
        let at = from + i
        let before_ok = at == 0 || !is_word_char(text.code_unit_at(at - 1))
        let after_ok = at + n == text.length() || !is_word_char(text.code_unit_at(at + n))
        if before_ok && after_ok {
          return true
        }
        from = at + 1
      }
    }
  }
  false
}

///|
/// How a failed command failed.
enum Failure {
  /// The version already exists on mooncakes.io.
  AlreadyPublished
  /// The server refused the credentials (401, 403).
  Refused
  /// The request conflicts with the state of the server (409).
  Conflict
  /// A temporary failure that a retry can fix.
  Transient
  /// Any other failure.
  Other
} derive(Eq, Debug)

///|
/// The words of each failure class, in the order that `classify_failure`
/// tries them: the first class with a match wins, so a refusal or a conflict
/// wins over the transient words. A word of the first list matches as whole
/// words, so `15020` and `thereof` do not count. A phrase of the second list
/// matches anywhere, so `TimeoutError` and Rust's `UnexpectedEof` count.
let failure_table : Array[(Failure, Array[String], Array[String])] = [
  (AlreadyPublished, [], ["is duplicated with an existing version"]),
  (Refused, ["401", "403"], []),
  (Conflict, ["409"], []),
  (
    Transient,
    ["eof", "502", "503", "504"],
    [
      "timed out", "timeout", "connection reset", "connection refused", "temporary failure",
      "rate limit", "prebuilt wasm asset does not exist", "unexpectedeof",
    ],
  ),
]

///|
/// The class of a command that failed with this output.
fn classify_failure(output : String) -> Failure {
  let text = output.to_lower()
  for row in failure_table {
    let (failure, words, phrases) = row
    if words.any(w => has_word(text, w)) || phrases.any(p => text.contains(p)) {
      return failure
    }
  }
  Other
}

///|
/// A failed network command is worth a retry only when the failure is
/// transient.
fn is_transient(exit_code : Int, output : String) -> Bool {
  exit_code != 0 && classify_failure(output) is Transient
}
// End of the failures.


///|
fn fail_with(message : String) -> Unit {
  eprintln("❌ \{message}")
  ExitCode::Failure.exit()
}

///|
/// Run `action` again after a transient failure: attempts at once, then after 5, 20 and 60 seconds.
/// It stops early on a failure that a retry does not fix.
async fn with_retry(
  label : String,
  action : async () -> (Int32, String),
) -> (Int32, String) {
  let waits = [5000, 20000, 60000]
  let mut result = action()
  for i, wait in waits {
    if !is_transient(result.0, result.1) {
      break
    }
    eprintln("↻ \{label}: attempt \{i + 2}/4")
    @async.sleep(wait)
    result = action()
  }
  result
}

///|
/// Run a command in a directory and return its exit code and its stdout and stderr together. A command
/// that cannot start gives code 1.
async fn output_in(
  dir : String,
  cmd : String,
  args : Array[String],
) -> (Int32, String) {
  let (code, out, err) = @process.collect_output(cmd, args, cwd=dir) catch {
    _ => return (1, "cannot start \{cmd}")
  }
  (code, out.text() + err.text())
}

///|
/// Publish one module. Returns the outcome and the last line of output.
async fn publish_module(dir : String, name : String) -> (Outcome, String) {
  let (update_code, update_out) = with_retry("update \{name}", () => {
    output_in(dir, "moon", ["update"])
  })
  if update_code != 0 {
    return (Failed, "`moon update` failed: \{update_out.trim()}")
  }
  let (code, out) = with_retry("publish \{name}", () => {
    output_in(dir, "moon", ["publish"])
  })
  let outcome = classify(code, out)
  (outcome, out.trim().to_owned())
}

///|
async fn publish_all() -> Unit {
  let mut failed = 0
  for entry in publish_list {
    let (dir, name) = entry
    let (outcome, out) = publish_module(dir, name)
    match outcome {
      Published => println("✅ \{name}: published")
      AlreadyPublished =>
        println("✅ \{name}: already published; nothing to do")
      Transient | Failed => {
        failed += 1
        eprintln("❌ \{name}: failed\n\{out}")
      }
    }
  }
  if failed > 0 {
    fail_with("\{failed} module(s) were not published")
  }
}

///|
/// Registry metadata can become visible before moonx can fetch the Wasm asset.
/// Retry that exact availability error with the same bounded network backoff.
async fn verify_cli(version : String) -> Unit {
  let (code, out) = with_retry("verify published CLI", () => {
    output_in(".", "moonx", ["moonrockz/mission-control-cli@\{version}", "version"])
  })
  if code != 0 {
    fail_with("the published CLI could not run: \{out.trim()}")
    return
  }
  println(out.trim())
}

///|
async fn main {
  match @env.args()[1:] {
    [] => publish_all()
    ["verify-cli", version] => verify_cli(version)
    _ => {
      eprintln("Usage: publish.mbtx [verify-cli X.Y.Z]")
      ExitCode::Usage.exit()
    }
  }
}

///|
/// Scenario state for `features/publish.feature`.
struct PublishWorld {
  moon_work : String
  own_source : String
  release_source : String
  mut exit_code : Int32
  mut output : String
}

///|
/// `moon_work` and `release_source` are the real texts of `moon.work` and `scripts/release.mbtx`. A step
/// cannot read a file, so the test reads them before the run.
fn PublishWorld::new(
  moon_work : String,
  own_source : String,
  release_source : String,
) -> PublishWorld {
  { moon_work, own_source, release_source, exit_code: 0, output: "" }
}

///|
/// The text of `source` from the line that starts with `start` to the line
/// `end`, both included, or `None` when either line is missing.
fn shared_block(source : String, start : String, end : String) -> String? {
  guard source.find(start) is Some(from) else { return None }
  guard source[from:].find(end) is Some(length) else { return None }
  Some(source[from:from + length + end.length()].to_owned())
}

///|
fn outcome_name(o : Outcome) -> String {
  match o {
    Published => "published"
    AlreadyPublished => "already published"
    Transient => "transient"
    Failed => "failed"
  }
}

///|
/// The module directories that `moon.work` lists, without a leading `./`.
fn work_members(text : String) -> Array[String] {
  let found = []
  for line in text.split("\n") {
    let entry = line.trim_start(chars=" \t\r").to_owned()
    guard entry.has_prefix("\"") else { continue }
    let rest = entry[1:]
    guard rest.find("\"") is Some(stop) else { continue }
    let path = rest[:stop].to_owned()
    found.push(if path.has_prefix("./") { path[2:].to_owned() } else { path })
  }
  found
}

///|
/// The text of one entry of the list, as `scripts/release.mbtx` writes it.
fn list_entry_text(entry : (String, String)) -> String {
  "(\"\{entry.0}\", \"\{entry.1}\"),"
}

///|
impl @moonspec.World for PublishWorld with fn configure(self, setup) {
  setup.given2("moon publish exits with {int} and prints {string}", fn(
    code : Int32,
    output : String,
  ) {
    self.exit_code = code
    self.output = output
  })
  setup.then1("the outcome is {string}", fn(expected : String) raise {
    @expect.expect(outcome_name(classify(self.exit_code, self.output))).to_equal(
      expected,
    )
  })
  setup.then3(
    "a command that exits with {int} and prints {string} is transient: {string}",
    fn(code : Int32, output : String, expected : String) raise {
      let actual = if is_transient(code, output) { "yes" } else { "no" }
      @expect.expect(actual).to_equal(expected)
    },
  )
  setup.then0("every module in the publish list is in moon.work", fn() raise {
    let members = work_members(self.moon_work)
    for entry in publish_list {
      @expect.expect(members.contains(entry.0)).to_equal(true)
    }
  })
  setup.then1("the failure class is {string}", fn(expected : String) raise {
    let actual = match classify_failure(self.output) {
      AlreadyPublished => "already published"
      Refused => "refused"
      Conflict => "conflict"
      Transient => "transient"
      Other => "other"
    }
    @expect.expect(actual).to_equal(expected)
  })
  setup.then0("the failure classes are the ones in release.mbtx", fn() raise {
    let start = "/// True when `word` occurs in `text` as whole words"
    let end = "// End of the failures."
    guard shared_block(self.own_source, start, end) is Some(own) else {
      fail("publish.mbtx has no failure block")
    }
    @expect.expect(shared_block(self.release_source, start, end)).to_equal(
      Some(own),
    )
  })
  setup.then0("the publish list is the one in release.mbtx", fn() raise {
    let release = self.release_source
    guard release.find("let publish_list") is Some(start) else {
      fail("release.mbtx has no publish_list")
    }
    let block = release[start:].to_owned()
    guard block.find("]\n") is Some(stop) else {
      fail("release.mbtx publish_list is not closed")
    }
    let found : Array[String] = []
    for line in block[:stop].to_owned().split("\n") {
      let line = line.trim().to_owned()
      if line.has_prefix("(\"") {
        found.push(line)
      }
    }
    let expected : Array[String] = publish_list.map(list_entry_text)
    @expect.expect(found).to_equal(expected)
  })
}

///|
async test "publish feature" {
  let moon_work = @fs.read_file("../moon.work").text()
  let own_source = @fs.read_file("publish.mbtx").text()
  let release_source = @fs.read_file("release.mbtx").text()
  @moonspec.run_or_fail(
    () => PublishWorld::new(moon_work, own_source, release_source),
    @moonspec.RunOptions::new([
      @moonspec.FeatureSource::File("features/publish.feature"),
    ]),
  )
  |> ignore
}
