///|
/// Build every workspace member for one or more targets.
///
/// Usage: `mise run build [-- <target>... [--release]]`, or `moonx scripts/build.mbtx <target>...`.
/// With no target, it builds wasm, wasm-gc, js and native. The native target is always a release build.
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/async@0.22.5/stdio",
  "moonbitlang/core/env",
  "moonbitlang/x@0.5.5/sys",
}

///|
/// The exit codes of the task scripts: 0 for success, 1 for a failure and 2
/// for a usage error. A script that succeeds ends `main` normally. Each script
/// keeps this copy, and `scripts/test-scripts.mbtx` checks that the copies are
/// equal.
enum ExitCode {
  Failure
  Usage
}

///|
/// Ends the script with this exit code.
fn ExitCode::exit(self : ExitCode) -> Unit {
  @sys.exit(
    match self {
      Failure => 1
      Usage => 2
    },
  )
}
// End of the exit codes.

///|
let usage : String = "Usage: mise run build [-- <target>... [--release]], where a target is wasm, wasm-gc, js or native"

///|
/// A MoonBit backend that the build and the tests target.
enum Backend {
  Wasm
  WasmGc
  Js
  Native
} derive(Eq, Debug)

///|
/// Every backend, in the order that a run with no target uses.
let all_backends : Array[Backend] = [Wasm, WasmGc, Js, Native]

///|
/// The name that `moon --target` takes.
fn Backend::name(self : Backend) -> String {
  match self {
    Wasm => "wasm"
    WasmGc => "wasm-gc"
    Js => "js"
    Native => "native"
  }
}

///|
/// The backend that `text` names, or `None` for any other text.
fn Backend::parse(text : String) -> Backend? {
  all_backends.iter().find_first(b => b.name() == text)
}

///|
/// The backends of the target arguments, or the first argument that names
/// no backend. No argument gives every backend.
fn parse_backends(args : ArrayView[String]) -> Result[Array[Backend], String] {
  let out = []
  for arg in args {
    match Backend::parse(arg) {
      Some(b) => out.push(b)
      None => return Err(arg)
    }
  }
  Ok(if out.is_empty() { all_backends } else { out })
}

///|
async fn main {
  let args = @env.args()[1:]
  let release = args.contains("--release")
  let names = args.filter(fn(arg) { arg != "--release" })
  let targets = match parse_backends(names) {
    Ok(targets) => targets
    Err(arg) => {
      eprintln("❌ \{arg} is not a target.\n\{usage}")
      ExitCode::Usage.exit()
      return
    }
  }
  for target in targets {
    println("🔨 Building for \{target.name()}...")
    let moon_args = ["build", "--target", target.name()]
    if release || target == Native {
      moon_args.push("--release")
    }
    let code = @process.run(
      "moon", moon_args,
      stdout=@stdio.stdout, stderr=@stdio.stderr,
    )
    if code != 0 {
      println("❌ Build failed for \{target.name()}")
      ExitCode::Failure.exit()
    }
  }
  println("✅ All builds complete")
}
