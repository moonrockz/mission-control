----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/x@0.5.5/sys",
  "moonbitlang/core/env",
  "moonrockz/moonspec@0.11.0",
  "moonrockz/expect@0.6.1",
}
----

///|
/// Write the mooncakes.io credentials from `MOONCAKES_USER_TOKEN` to `$MOON_HOME/credentials.json`, or to
/// `~/.moon/credentials.json` when `MOON_HOME` is not set (CI only).
///
/// Usage: `mise run release:credentials`, or `moonx scripts/credentials.mbtx`. The script exits with a
/// non-zero code when the token is missing or empty.

///|
/// The exit codes of the task scripts: 0 for success, 1 for a failure and 2
/// for a usage error. A script that succeeds ends `main` normally. Each script
/// keeps this copy, and `scripts/test-scripts.mbtx` checks that the copies are
/// equal.
enum ExitCode {
  Failure
  Usage
}

///|
/// Ends the script with this exit code.
fn ExitCode::exit(self : ExitCode) -> Unit {
  @sys.exit(
    match self {
      Failure => 1
      Usage => 2
    },
  )
}
// End of the exit codes.

///|
let usage : String = "Usage: mise run release:credentials"

///|
let token_var : String = "MOONCAKES_USER_TOKEN"

///|
fn fail_with(message : String) -> Unit {
  eprintln("❌ \{message}")
  ExitCode::Failure.exit()
}

///|
/// Why the script cannot write the credentials.
enum CredentialsError {
  /// The token variable is missing or empty.
  TokenNotSet
  /// Neither `MOON_HOME` nor `HOME` is set.
  NoMoonDirectory
} derive(Eq, Debug)

///|
fn CredentialsError::message(self : CredentialsError) -> String {
  match self {
    TokenNotSet => "\{token_var} is not set; cannot write mooncakes.io credentials"
    NoMoonDirectory => "neither MOON_HOME nor HOME is set; cannot locate the moon directory"
  }
}

///|
/// Return the token, or `TokenNotSet` when it is missing or empty.
fn require_token(value : String?) -> Result[String, CredentialsError] {
  match value {
    Some(token) if token != "" => Ok(token)
    _ => Err(TokenNotSet)
  }
}

///|
/// Render `{"token": ...}` with correct JSON escaping.
fn credentials_json(token : String) -> String {
  let json : Json = { "token": Json(token) }
  json.stringify(indent=2) + "\n"
}

///|
/// Return the directory where `moon` reads `credentials.json`: `MOON_HOME` when it is set and not empty,
/// else `$HOME/.moon`.
fn credentials_dir(moon_home : String?, home : String?) -> Result[String, CredentialsError] {
  match (moon_home, home) {
    (Some(dir), _) if dir != "" => Ok(dir)
    (_, Some(home)) if home != "" => Ok("\{home}/.moon")
    _ => Err(NoMoonDirectory)
  }
}

///|
async fn main {
  guard @env.args().length() <= 1 else {
    eprintln(usage)
    ExitCode::Usage.exit()
    return
  }
  let token = match require_token(@env.get_env_var(token_var)) {
    Ok(token) => token
    Err(error) => {
      fail_with(error.message())
      return
    }
  }
  let dir = match
    credentials_dir(@env.get_env_var("MOON_HOME"), @env.get_env_var("HOME")) {
    Ok(dir) => dir
    Err(error) => {
      fail_with(error.message())
      return
    }
  }
  @fs.mkdir(dir, recursive=true, allow_exist=true)
  @fs.write_file("\{dir}/credentials.json", credentials_json(token), permission=0o600)
  println("Credentials written to \{dir}/credentials.json")
}

///|
/// Scenario state for `features/credentials.feature`.
struct CredentialsWorld {
  mut token : String?
  /// The result of the last step, or `None` before a step runs.
  mut result : Result[String, CredentialsError]?
  mut moon_home : String?
  mut home : String?
}

///|
fn CredentialsWorld::new() -> CredentialsWorld {
  { token: None, result: None, moon_home: None, home: None }
}

///|
impl @moonspec.World for CredentialsWorld with fn configure(self, setup) {
  setup.given1("the token is {string}", fn(token : String) {
    self.token = Some(token)
  })
  setup.given0("no token is set", fn() { self.token = None })
  setup.given1("MOON_HOME is {string}", fn(dir : String) { self.moon_home = Some(dir) })
  setup.given1("HOME is {string}", fn(dir : String) { self.home = Some(dir) })
  setup.when0("I choose the credentials directory", fn() {
    self.result = Some(credentials_dir(self.moon_home, self.home))
  })
  setup.then1("the directory is {string}", fn(dir : String) raise {
    @expect.expect(self.result).to_equal(Some(Ok(dir)))
  })
  setup.when0("I render the credentials", fn() {
    self.result = Some(require_token(self.token).map(credentials_json))
  })
  setup.then1("the credentials file is:", fn(doc : @moonspec.DocString) raise {
    @expect.expect(self.result).to_equal(Some(Ok(doc.content + "\n")))
  })
  setup.then1("rendering fails with {string}", fn(message : String) raise {
    @expect.expect(self.result.map(r => r.map_err(e => e.message()))).to_equal(Some(Err(message)))
  })
  setup.then1("choosing the directory fails with {string}", fn(message : String) raise {
    @expect.expect(self.result.map(r => r.map_err(e => e.message()))).to_equal(Some(Err(message)))
  })
}

///|
async test "credentials feature" {
  @moonspec.run_or_fail(
    CredentialsWorld::new,
    @moonspec.RunOptions::new([
      @moonspec.FeatureSource::File("features/credentials.feature"),
    ]),
  )
  |> ignore
}
