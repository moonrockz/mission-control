///|
/// Run the tests of the task scripts.
///
/// A script is tested when it declares tests or `scripts/features/<stem>.feature` exists, where `<stem>` is the script name
/// without `.mbtx` and with `-` replaced by `_`. `moon test` of a package does not include `.mbtx` files,
/// so this script is their only test runner. It uses the wasm backend, as `moonx` does for a standalone
/// `.mbtx` file. It stops at the first failure.
///
/// Usage: `mise run test:scripts`, or `moonx scripts/test-scripts.mbtx`.
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/async@0.22.5/stdio",
  "moonbitlang/x@0.5.5/sys",
  "moonbitlang/core/env",
}

///|
/// The exit codes of the task scripts: 0 for success, 1 for a failure and 2
/// for a usage error. A script that succeeds ends `main` normally. Each script
/// keeps this copy, and `scripts/test-scripts.mbtx` checks that the copies are
/// equal.
enum ExitCode {
  Failure
  Usage
}

///|
/// Ends the script with this exit code.
fn ExitCode::exit(self : ExitCode) -> Unit {
  @sys.exit(
    match self {
      Failure => 1
      Usage => 2
    },
  )
}
// End of the exit codes.

///|
let usage : String = "Usage: mise run test:scripts"

///|
let scripts_dir : String = "scripts"

///|
/// The feature file name that belongs to a script file name, or `None` for a file that is not a script.
fn feature_name(file : String) -> String? {
  guard file.has_suffix(".mbtx") else { return None }
  let stem = file[:file.length() - 5].to_owned()
  Some(stem.replace(old="-", new="_") + ".feature")
}

///|
async fn main {
  guard @env.args().length() <= 1 else {
    eprintln(usage)
    ExitCode::Usage.exit()
    return
  }
  let files = @fs.readdir(scripts_dir, sort=true)
  let mut tested = 0
  for file in files {
    guard feature_name(file) is Some(feature) else { continue }
    let source = @fs.read_file("\{scripts_dir}/\{file}").text()
    let declares_tests = source
      .split("\n")
      .any(line => {
        let line = line.trim_start()
        line.has_prefix("test \"") || line.has_prefix("async test \"")
      })
    guard declares_tests || @fs.exists("\{scripts_dir}/features/\{feature}") else {
      continue
    }
    println("🧪 Testing \{scripts_dir}/\{file}")
    let code = @process.run(
      "moon",
      ["test", "--deny-warn", "--target", "wasm", "\{scripts_dir}/\{file}"],
      stdout=@stdio.stdout,
      stderr=@stdio.stderr,
    )
    if code != 0 {
      eprintln("❌ The tests of \{scripts_dir}/\{file} failed.")
      ExitCode::Failure.exit()
    }
    tested += 1
  }
  println("✅ Tested \{tested} scripts")
}

///|
/// The text of `source` from the line that starts with `start` to the line
/// `end`, both included, or `None` when either line is missing.
fn shared_block(source : String, start : String, end : String) -> String? {
  guard source.find(start) is Some(from) else { return None }
  guard source[from:].find(end) is Some(length) else { return None }
  Some(source[from:from + length + end.length()].to_owned())
}

///|
async test "every script keeps the same copy of the exit codes" {
  let start = "/// The exit codes of the task scripts"
  let end = "// End of the exit codes."
  let own = shared_block(@fs.read_file("test-scripts.mbtx").text(), start, end)
  assert_true(own is Some(_))
  for file in @fs.readdir(".", sort=true) {
    guard feature_name(file) is Some(_) else { continue }
    let source = @fs.read_file(file).text()
    assert_eq(shared_block(source, start, end), own, msg=file)
  }
}
