///|
/// Run the tests of every workspace member for one or more targets.
///
/// Usage: `mise run test [-- <target>...]`, or `moonx scripts/test.mbtx <target>...`.
/// With no target, it tests wasm, wasm-gc, js and native.
///
/// `moon test <path>` tests only the package at exactly that path, not its
/// sub-packages, so packages are discovered from `moon.work` recursively.
/// Packages declare target restrictions in their `moon.pkg`.
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/stdio",
  "moonbitlang/core/env",
  "moonbitlang/x@0.5.5/sys",
}

///|
/// The exit codes of the task scripts: 0 for success, 1 for a failure and 2
/// for a usage error. A script that succeeds ends `main` normally. Each script
/// keeps this copy, and `scripts/test-scripts.mbtx` checks that the copies are
/// equal.
enum ExitCode {
  Failure
  Usage
}

///|
/// Ends the script with this exit code.
fn ExitCode::exit(self : ExitCode) -> Unit {
  @sys.exit(
    match self {
      Failure => 1
      Usage => 2
    },
  )
}
// End of the exit codes.

///|
let usage : String = "Usage: mise run test [-- <target>...], where a target is wasm, wasm-gc, js or native"

///|
/// A MoonBit backend that the build and the tests target. `scripts/build.mbtx`
/// and `scripts/test.mbtx` keep the same copy, and `scripts/test-scripts.mbtx`
/// checks that the copies are equal.
enum Backend {
  Wasm
  WasmGc
  Js
  Native
} derive(Eq, Debug)

///|
/// Every backend, in the order that a run with no target uses.
let all_backends : Array[Backend] = [Wasm, WasmGc, Js, Native]

///|
/// The name that `moon --target` takes.
fn Backend::name(self : Backend) -> String {
  match self {
    Wasm => "wasm"
    WasmGc => "wasm-gc"
    Js => "js"
    Native => "native"
  }
}

///|
/// The backend that `text` names, or `None` for any other text.
fn Backend::parse(text : String) -> Backend? {
  all_backends.iter().find_first(b => b.name() == text)
}

///|
/// The backends of the target arguments, or the first argument that names
/// no backend. No argument gives every backend.
fn parse_backends(args : ArrayView[String]) -> Result[Array[Backend], String] {
  let out = []
  for arg in args {
    match Backend::parse(arg) {
      Some(b) => out.push(b)
      None => return Err(arg)
    }
  }
  Ok(if out.is_empty() { all_backends } else { out })
}
// End of the backends.

///|
/// Active workspace members, excluding the package-less workspace root.
fn members(work : String) -> Array[String] {
  let paths = []
  for line in work.split("\n") {
    let line = line.trim_start()
    guard line.has_prefix("\"") else { continue }
    guard line[1:].find("\"") is Some(end) else { continue }
    let path = line[1:1 + end].to_owned()
    let path = if path.has_prefix("./") { path[2:].to_owned() } else { path }
    if path != "." && !path.is_empty() {
      paths.push(path)
    }
  }
  paths
}

///|
/// A package's optional target restriction, in moon.pkg's target expression.
fn supports(config : String, target : Backend) -> Bool {
  for line in config.split("\n") {
    let line = line.trim_start()
    guard line.has_prefix("supported_targets") else { continue }
    guard line.find("\"") is Some(start) &&
      line.rev_find("\"") is Some(end) &&
      end > start else {
      return false
    }
    return line[start + 1:end].split("+").any(t => t == target.name())
  }
  true
}

///|
/// Find each package once, including newly added and internal packages.
async fn packages(dir : String, target : Backend, out : Array[String]) -> Unit {
  let manifest = "\{dir}/moon.pkg"
  if @fs.exists(manifest) && supports(@fs.read_file(manifest).text(), target) {
    out.push(dir)
  }
  let entries = @fs.readdir(dir)
  entries.sort()
  for entry in entries {
    guard !entry.has_prefix(".") && entry != "_build" && entry != "node_modules" else {
      continue
    }
    let path = "\{dir}/\{entry}"
    if @fs.kind(path) is Directory {
      packages(path, target, out)
    }
  }
}

///|
async fn moon_test(paths : Array[String], target : Backend) -> Int32 {
  let args = ["test"]
  args.append(paths)
  args.push("--target")
  args.push(target.name())
  @process.run("moon", args, stdout=@stdio.stdout, stderr=@stdio.stderr)
}

///|
async fn main {
  let targets = match parse_backends(@env.args()[1:]) {
    Ok(targets) => targets
    Err(arg) => {
      eprintln("❌ \{arg} is not a target.\n\{usage}")
      ExitCode::Usage.exit()
      return
    }
  }
  for target in targets {
    println("🧪 Testing for \{target.name()}...")
    let paths = []
    for module_path in members(@fs.read_file("moon.work").text()) {
      packages(module_path, target, paths)
    }
    if paths.is_empty() {
      println("No test packages for \{target.name()}")
      ExitCode::Failure.exit()
    }
    let code = moon_test(paths, target)
    if code != 0 {
      println("❌ Tests failed for \{target.name()}")
      ExitCode::Failure.exit()
    }
  }
  println("✅ All tests passed")
}

///|
test "workspace members ignore commented paths and the workspace root" {
  assert_eq(
    members("members = [\n  \".\",\n  # \"./skip\",\n  \"./pkgs/new\",\n]"),
    ["pkgs/new"],
  )
}

///|
test "package target restrictions preserve native and wasm only" {
  assert_true(supports("supported_targets = \"native+wasm\"", Native))
  assert_true(supports("supported_targets = \"native+wasm\"", Wasm))
  assert_false(supports("supported_targets = \"native+wasm\"", WasmGc))
  assert_true(supports("", Js))
}

///|
test "a misspelled target is refused before any test runs" {
  assert_eq(parse_backends(["js", "jss"]), Err("jss"))
  assert_eq(parse_backends(["wasm-gc", "native"]), Ok([WasmGc, Native]))
  assert_eq(parse_backends([]), Ok(all_backends))
}
